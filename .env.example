# Arquivo de configuração da API (.env.example)
# Copie para .env e customize conforme necessário

# Configuração do Host e Porta
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/api.log

# Caminhos dos modelos
MODEL_PATH=./data/models/lstm_5factor_final_20260101_224540.keras
SCALER_PATH=./data/models/scaler_5factor_final_20260101_224540.pkl

# Configuração do modelo
SEQUENCE_LENGTH=70
NUM_FEATURES=34
BATCH_SIZE=32

# CORS
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=false
CORS_METHODS=["*"]
CORS_HEADERS=["*"]

# Rate Limiting (futuro)
# RATE_LIMIT_ENABLED=false
# RATE_LIMIT_PER_MINUTE=100

# Autenticação (futuro)
# API_KEY_ENABLED=false
# API_KEY=your-secret-key

# Database (futuro)
# DATABASE_URL=sqlite:///./predictions.db

# Environment
ENVIRONMENT=development
# Outros valores: staging, production
